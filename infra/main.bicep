// Next Stop: Asia backend. Deploys nothing on its own: run it through infra/deploy.sh after review.
targetScope = 'resourceGroup'

@description('Azure region. Must support Flex Consumption: az functionapp list-flexconsumption-locations')
param location string = resourceGroup().location

@description('Short lowercase prefix for resource names.')
@maxLength(10)
param namePrefix string = 'nsa'

@description('Comma-separated allowlist of browser origins, e.g. https://next-stop-asia.vercel.app')
param allowedOrigins string

@secure()
@description('Authorises POST /api/groups. Generated by deploy.sh; never commit it.')
param groupCreationSecret string

@secure()
@description('Salt for hashing client addresses in rate-limit keys.')
param rateLimitSalt string

@secure()
@description('Signs session cookies. Generated by deploy.sh; changing it signs everyone out.')
param sessionSecret string

@description('OAuth web client id from Google Cloud Console. Not a secret.')
param googleClientId string

@description('Comma-separated Google accounts with admin rights.')
param adminEmails string

@description('SameSite attribute for the session cookie. Lax with the Vercel rewrite; None only for direct cross-site calls.')
@allowed(['Lax', 'Strict', 'None'])
param cookieSameSite string = 'Lax'

@description('Adds Application Insights and Log Analytics, which may incur ingestion charges.')
param enableMonitoring bool = false

var suffix = uniqueString(resourceGroup().id)
var storageName = take('${namePrefix}${suffix}', 24)
var functionAppName = '${namePrefix}-api-${suffix}'
var tableName = 'nextstopasia'
var deploymentContainer = 'deployments'

resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: storageName
  location: location
  kind: 'StorageV2'
  sku: { name: 'Standard_LRS' }
  properties: {
    accessTier: 'Hot'
    allowBlobPublicAccess: false
    // Everything authenticates through the managed identity: no account key is ever needed.
    allowSharedKeyAccess: false
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
  }

  resource blobServices 'blobServices' = {
    name: 'default'
    resource container 'containers' = {
      name: deploymentContainer
    }
  }

  resource tableServices 'tableServices' = {
    name: 'default'
    resource table 'tables' = {
      name: tableName
    }
  }
}

resource workspace 'Microsoft.OperationalInsights/workspaces@2023-09-01' = if (enableMonitoring) {
  name: '${namePrefix}-logs-${suffix}'
  location: location
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
    workspaceCapping: { dailyQuotaGb: json('0.1') }
  }
}

resource insights 'Microsoft.Insights/components@2020-02-02' = if (enableMonitoring) {
  name: '${namePrefix}-insights-${suffix}'
  location: location
  kind: 'web'
  properties: {
    Application_Type: 'web'
    WorkspaceResourceId: workspace.id
  }
}

resource plan 'Microsoft.Web/serverfarms@2023-12-01' = {
  name: '${namePrefix}-plan-${suffix}'
  location: location
  kind: 'functionapp'
  sku: { tier: 'FlexConsumption', name: 'FC1' }
  properties: { reserved: true }
}

var baseSettings = [
  { name: 'AzureWebJobsStorage__accountName', value: storage.name }
  { name: 'STORAGE_TABLE_ENDPOINT', value: storage.properties.primaryEndpoints.table }
  { name: 'TABLE_NAME', value: tableName }
  { name: 'ALLOWED_ORIGINS', value: allowedOrigins }
  { name: 'COOKIE_SECURE', value: 'true' }
  { name: 'COOKIE_SAMESITE', value: cookieSameSite }
  { name: 'GROUP_CREATION_SECRET', value: groupCreationSecret }
  { name: 'RATE_LIMIT_SALT', value: rateLimitSalt }
  { name: 'SESSION_SECRET', value: sessionSecret }
  { name: 'GOOGLE_CLIENT_ID', value: googleClientId }
  { name: 'ADMIN_EMAILS', value: adminEmails }
]

var monitoringSettings = enableMonitoring
  ? [{ name: 'APPLICATIONINSIGHTS_CONNECTION_STRING', value: insights!.properties.ConnectionString }]
  : []

resource functionApp 'Microsoft.Web/sites@2023-12-01' = {
  name: functionAppName
  location: location
  kind: 'functionapp,linux'
  identity: { type: 'SystemAssigned' }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    siteConfig: {
      minTlsVersion: '1.2'
      ftpsState: 'Disabled'
      appSettings: concat(baseSettings, monitoringSettings)
    }
    functionAppConfig: {
      deployment: {
        storage: {
          type: 'blobContainer'
          value: '${storage.properties.primaryEndpoints.blob}${deploymentContainer}'
          authentication: { type: 'SystemAssignedIdentity' }
        }
      }
      // No always-ready instances: the app scales to zero when idle.
      scaleAndConcurrency: {
        maximumInstanceCount: 40
        instanceMemoryMB: 512
      }
      runtime: { name: 'node', version: '22' }
    }
  }
}

var roles = {
  blobDataOwner: 'b7e6dc6d-f1e8-4753-8033-0f276bb0955b'
  queueDataContributor: '974c5e8b-45b9-4653-ba55-5f855dd0fb88'
  tableDataContributor: '0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3'
}

resource roleAssignments 'Microsoft.Authorization/roleAssignments@2022-04-01' = [
  for role in items(roles): {
    name: guid(storage.id, functionApp.id, role.value)
    scope: storage
    properties: {
      principalId: functionApp.identity.principalId
      principalType: 'ServicePrincipal'
      roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', role.value)
    }
  }
]

output functionAppName string = functionApp.name
output functionAppUrl string = 'https://${functionApp.properties.defaultHostName}'
output storageAccountName string = storage.name
