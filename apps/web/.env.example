# demo = local-only votes (no backend). api = real shared voting.
VITE_VOTING_MODE=demo
# Group id printed by `pnpm --filter @nsa/api create-group`.
VITE_GROUP_ID=
# Leave empty to call same-origin /api through the Vercel rewrite (recommended).
VITE_API_BASE_URL=
# OAuth web client id from Google Cloud Console. Not a secret. Empty uses a local dev sign-in form.
VITE_GOOGLE_CLIENT_ID=
